# Copy this file to .env and adjust as needed. Values here are development-only
# defaults — never use them (or this pattern) for a real deployment.

# --- Shared network ---
COMPOSE_NETWORK=gateway-sample-net

# --- PostgreSQL ---
POSTGRES_DB=gatewaysample
POSTGRES_USER=gatewaysample
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_PORT=5432
# product, pricing, and gateway schemas are created by each service's own
# Flyway migrations (Phase 2 / Phase 4), not by this container's init scripts.

# --- Redis ---
REDIS_PORT=6379
# No auth in local dev; do not expose this port outside localhost.

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password
# Realm is imported from infrastructure/keycloak/realm-export.json (Phase 3):
# roles catalog.read/catalog.write/pricing.read/pricing.write, the public
# "web-ui" PKCE client, the confidential "smoke-tests" client, and demo users
# alice (full access) / bob (read-only).
KEYCLOAK_REALM=gateway-sample
# External issuer as seen by the browser and embedded in every JWT's `iss`
# claim (Keycloak's start-dev mode derives `iss` from the request Host header,
# so this must match how the browser and smoke-tests reach Keycloak).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/gateway-sample
# JWKS endpoint as reached by services running directly on the host. When
# services run inside docker-compose.yml, this is overridden per-service to
# the internal http://keycloak:8080/... address instead.
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/gateway-sample/protocol/openid-connect/certs

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-admin-password

# --- Prometheus / Tempo / Loki ---
PROMETHEUS_PORT=9090
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
LOKI_PORT=3100
ALLOY_PORT=12345

# --- Application services ---
GATEWAY_PORT=8080
API_SERVER_PORT=8081
PRODUCT_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
WEB_UI_PORT=8090

# --- API key hashing (Phase 4) ---
# Server-side pepper mixed into the HMAC-SHA256 digest of stored API keys.
# Placeholder only until Phase 4 wires it up; rotate before any non-local use.
API_KEY_PEPPER=dev-only-api-key-pepper-change-me
