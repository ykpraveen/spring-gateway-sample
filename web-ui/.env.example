# Copy to .env (or .env.local) to override. These defaults work out of the box for both
# `npm run dev` (Vite on :5173) and the Docker-Compose-served build (nginx on :8090) — the
# browser always talks to the gateway/Keycloak host ports directly, regardless of which port
# web-ui itself is served from, so these values don't need to change between the two.

# Gateway base URL (the only public backend entry point; see PLAN.md "Public API").
VITE_GATEWAY_BASE_URL=http://localhost:8080

# Keycloak issuer used for the browser-side PKCE login/logout redirects. Must match the
# "web-ui" client's redirectUris/webOrigins in infrastructure/keycloak/realm-export.json.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=gateway-sample
VITE_KEYCLOAK_CLIENT_ID=web-ui
